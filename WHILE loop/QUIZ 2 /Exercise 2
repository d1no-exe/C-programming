/*
 * Problem:    Napisati glavni program int main() koji će na ulazu učitati jedan cijeli broj N, a na izlazu ispisati zbir njegove najveće i najmanje cifre. Obavezno korištenje WHILE petlje.
 * Link:       
 * Difficulty: Easy
 * Pattern:    
 * Time:       10(min)
 * Space:      O(n)
 * Notes:      Zadatak poprilicno lagan nakon sto sam skontao kako uraditi prethodni zadatak.
 *             Revisit: 
 */



int main()
{
    int n, najmanjaCifra, najvecaCifra=0,
        suma = 0, cifra = 0;
    
    scanf("%d", &n);
    najmanjaCifra = n;
    
    while (n != 0)
    {
        cifra = n % 10;
        n = n / 10;
        
        if (cifra < najmanjaCifra)
            najmanjaCifra = cifra;
        
        if (cifra > najvecaCifra)
            najvecaCifra = cifra;
    }
    
    suma = najmanjaCifra + najvecaCifra;
    printf("%d", suma);
    
    return 0;
}
